# ---------------------------------------------------------------------------
# Required — the planner will not run without these
# ---------------------------------------------------------------------------

# Gemini. Every agent uses it. Override the model with GEMINI_MODEL below.
GOOGLE_API_KEY=

# Web research: weather, safety, visas, seasonal events.
TAVILY_API_KEY=

# Live flights, hotels, places and currency conversion.
SERPAPI_API_KEY=

# Optional: the Gemini model every agent runs on. Defaults to gemini-3.5-flash.
# Change it here if a model is retired, or is returning 503 under load —
# no code change needed. `gemini-3.6-flash` is the usual alternative.
# GEMINI_MODEL=gemini-3.6-flash


# ---------------------------------------------------------------------------
# Optional — Google Calendar over MCP (agent #11)
# ---------------------------------------------------------------------------
# Leave CALENDAR_MCP_ENABLED unset and the Calendar Agent writes a .ics file to
# exports/ instead. Everything else works exactly the same.
#
# To write events straight into a real Google Calendar:
#
#   1. Google Cloud Console -> create or pick a project
#   2. Enable the "Google Calendar API"
#   3. Credentials -> Create credentials -> OAuth client ID -> Desktop app
#   4. Download the JSON as gcp-oauth.keys.json
#   5. Point GOOGLE_OAUTH_CREDENTIALS at it and set CALENDAR_MCP_ENABLED=true
#   6. The first run opens a browser once to grant access
#
# Requires Node.js on PATH: the MCP server is fetched and run with npx.

CALENDAR_MCP_ENABLED=false
GOOGLE_OAUTH_CREDENTIALS=

# Override only to use a different MCP server.
# CALENDAR_MCP_COMMAND=npx
# CALENDAR_MCP_ARGS=-y @cocal/google-calendar-mcp


# ---------------------------------------------------------------------------
# Optional — LangSmith tracing
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=autonomous-trip-planner
