# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# The model every agent runs on, in LangChain's `provider:model` form.
# A bare name is assumed to be OpenAI.
LLM_MODEL=openai:gpt-5-mini

# The provider's key. Only the one your LLM_MODEL needs is required.
OPENAI_API_KEY=
# GOOGLE_API_KEY=          # needed only for google_genai:* models

# Optional per-agent overrides (model tiering). Cheap formatting work can run
# on a smaller, faster model while the reasoning-heavy agents keep the strong
# one. Roles: manager intake destination_research flights lodging attractions
#             routing budget critic itinerary calendar
# LLM_MODEL_INTAKE=openai:gpt-5-nano
# LLM_MODEL_CALENDAR=openai:gpt-5-nano
# LLM_MODEL_CRITIC=openai:gpt-5


# ---------------------------------------------------------------------------
# Data sources — both required
# ---------------------------------------------------------------------------

# Web research: weather, safety, visas, seasonal events.
TAVILY_API_KEY=

# Live flights, hotels, places and currency conversion.
SERPAPI_API_KEY=


# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Cache tool results on disk. Prices expire in hours, places in days. Turning
# this off makes every run hit the live APIs again.
TRIP_CACHE_ENABLED=true

# Persist runs to SQLite so a failed plan can be resumed instead of replanned.
TRIP_CHECKPOINTS=true

# How many places the Attractions Agent may gather, in total. Every place is
# carried whole through Routing and the Critic, so this is the main lever on
# what a run costs. 15 is plenty for a test run; raise it for a long trip.
TRIP_MAX_PLACES=15

# Let the planner pause and ask when a required detail is missing, instead of
# stopping. Needs checkpointing, and a UI that can answer.
TRIP_ASK_USER=true

# Spend an LLM call per stage on the manager's narration. Off by default: the
# routing decision is computed in Python, so this only buys prettier wording
# and used to cost ~30 model round trips per plan.
EXPLAIN_ROUTING=false


# ---------------------------------------------------------------------------
# Optional — Google Calendar over MCP (agent #11)
# ---------------------------------------------------------------------------
# Leave CALENDAR_MCP_ENABLED off and the Calendar Agent writes a .ics file to
# exports/ instead. Everything else works exactly the same.
#
#   1. Google Cloud Console -> create or pick a project
#   2. Enable the "Google Calendar API"
#   3. Credentials -> Create credentials -> OAuth client ID -> Desktop app
#   4. Download the JSON (keep it OUT of any cloud-synced folder)
#   5. Point GOOGLE_OAUTH_CREDENTIALS at it, set CALENDAR_MCP_ENABLED=true
#   6. Run `npx @cocal/google-calendar-mcp auth` once to grant access
#
# Requires Node.js on PATH: the MCP server is fetched and run with npx.

CALENDAR_MCP_ENABLED=false
GOOGLE_OAUTH_CREDENTIALS=

# Override only to use a different MCP server.
# CALENDAR_MCP_COMMAND=npx
# CALENDAR_MCP_ARGS=-y @cocal/google-calendar-mcp


# ---------------------------------------------------------------------------
# Optional — LangSmith tracing
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=Autonomous Trip Planner
